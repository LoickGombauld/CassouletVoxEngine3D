+vec4 sampleAtlas(
+    vec2 localUV,
+    int textureIndex
+)
+{
+    vec2 wrapped = fract(localUV);
+
+    int column = textureIndex % ATLAS_COLUMNS;
+    int row = textureIndex / ATLAS_COLUMNS;
+
+    int localX = int(floor(wrapped.x * float(TILE_WIDTH)));
+    int localY = int(floor(wrapped.y * float(TILE_HEIGHT)));
+
+    localX = clamp(localX, 0, TILE_WIDTH - 1);
+    localY = clamp(localY, 0, TILE_HEIGHT - 1);
+
+    ivec2 texel = ivec2(
+        column * TILE_WIDTH + localX,
+        row * TILE_HEIGHT + localY
+    );
+
+    return texelFetch(
+        u_TextureAtlas,
+        texel,
+        0
+    );
+}
